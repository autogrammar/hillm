{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hillm.dev/contracts/nlp2hillm/v1/dsl-line.schema.json",
  "title": "DslLineResponse v1",
  "type": "object",
  "required": ["contractVersion", "dsl"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "dsl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(HEALTH|DEVICES|ORIENT|ACTIONS|VALIDATE|READ|STATUS|RESOLVE|WRITE|ACTUATE|CONNECT|DISCONNECT|EXECUTE)(?:\\s.*)?$"
    }
  },
  "additionalProperties": false
}
